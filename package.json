{
	"name": "kitsune-calculator",
	"description": "A calculator for estimating kitsune tails, ears, and body proportions.",
	"private": true,
	"version": "4.0.0",
	"license": "MIT",
	"author": {
		"name": "Decaded",
		"url": "https://github.com/Decaded"
	},
	"homepage": "https://foxgirl.decaded.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Decaded/Foxgirl-Tail-Calculator.git"
	},
	"bugs": {
		"url": "https://github.com/Decaded/Foxgirl-Tail-Calculator/issues"
	},
	"keywords": [
		"kitsune",
		"calculator",
		"foxgirl",
		"preact",
		"vite"
	],
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"preact": "^11.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@preact/preset-vite": "^2.10.6",
		"@tailwindcss/vite": "^4.3.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"scripts": {
		"dev": "vite",
		"build": "npm run typecheck && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check . && node scripts/check-hex.mjs",
		"format": "biome check --write ."
	}
}
